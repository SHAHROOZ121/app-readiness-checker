# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend Supabase Service Role (server-side only)
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Google PageSpeed API
VITE_PAGESPEED_API_KEY=your_pagespeed_api_key

# Stripe Configuration (API Keys)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Stripe Price IDs (from your Stripe Dashboard)
# Use STRIPE_ prefix for server-side (optional: also support VITE_ prefix for compatibility)
STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxxxxxx
STRIPE_PRICE_PRO_ANNUAL=price_xxxxxxxxxxxx
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxxxxxxxxxxx
STRIPE_PRICE_PREMIUM_ANNUAL=price_xxxxxxxxxxxx

# Also optionally set VITE_ prefix for frontend access
VITE_STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxxxxxx
VITE_STRIPE_PRICE_PRO_ANNUAL=price_xxxxxxxxxxxx
VITE_STRIPE_PRICE_PREMIUM_MONTHLY=price_xxxxxxxxxxxx
VITE_STRIPE_PRICE_PREMIUM_ANNUAL=price_xxxxxxxxxxxx

# Stripe Webhook Secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Application URL (for Stripe redirects)
VERCEL_URL=https://your-domain.com
